# Copy to backend/.env and adjust. Never commit the real .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://autograder:autograder@localhost:5433/autograder
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=60
TEACHER_INVITE_CODE=PROF-2026

# Code execution: "docker" (sandbox) or "subprocess" (prototype, only with ENV=dev)
RUNNER=docker
SANDBOX_IMAGE=autograder-python:latest
MAX_CONCURRENT_RUNS=2
MIN_SUBMISSION_INTERVAL_S=5
