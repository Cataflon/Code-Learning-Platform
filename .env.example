# Copy to backend/.env and adjust. Never commit the real .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://autograder:autograder@localhost:5433/autograder
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=60
# Also accepted besides the codes an admin generates; empty = admin codes only
TEACHER_INVITE_CODE=PROF-2026

# Code execution: "docker" (sandbox) or "subprocess" (prototype, only with ENV=dev)
RUNNER=docker
SANDBOX_IMAGE=autograder-python:latest
MAX_CONCURRENT_RUNS=2
# Where the runner writes the files it mounts in the sandbox; empty = system temp folder
SANDBOX_WORK_DIR=

# Logging and abuse limits (Step 10)
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_10_MINUTES=20
MIN_SUBMISSION_INTERVAL_S=5
CONCEPT_REVIEW_BELOW=0.5
CONCEPT_MASTERED_FROM=0.8

# Course materials
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=20
PPTX_CONVERT_TIMEOUT_S=60
SOFFICE_PATH=

# AI test generation (optional; without a key the feature is hidden and its routes answer 503)
AI_ENABLED=true
# gemini (default): Google AI Studio, key in GEMINI_API_KEY (aistudio.google.com, Get API key)
# nvidia: NVIDIA API catalog (build.nvidia.com), key in NVIDIA_API_KEY
# anthropic: Claude, key in ANTHROPIC_API_KEY
AI_PROVIDER=gemini
GEMINI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
# Empty = the provider's default (gemini-3.5-flash, then gemini-3.5-flash-lite and
# gemini-3.1-flash-lite when it is busy). AI_FALLBACK_MODELS is comma-separated.
AI_MODEL=
AI_FALLBACK_MODELS=
AI_BASE_URL=
AI_EFFORT=high
# Per attempt, in seconds; 0 = provider default (45 for Gemini, 120 for the others)
AI_TIMEOUT_S=0
AI_MAX_JOBS_PER_HOUR=5
